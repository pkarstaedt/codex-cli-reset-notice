{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex_reset.py\"",
            "timeout": 5,
            "statusMessage": "Checking global reset status"
          }
        ]
      }
    ]
  }
}
